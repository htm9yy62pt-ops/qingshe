{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "plugins": [],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "jsx": "preserve",
    "outDir": ".harness",
    "rootDir": ".",
    "isolatedModules": false,
    "skipLibCheck": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "scripts/route-harness.ts", "scripts/router-debug.ts", "scripts/storage-harness.ts", "scripts/trace-p1.ts", "scripts/trace-shopping.ts", "scripts/onboarding-harness.ts"], 
  "exclude": ["node_modules", ".next", ".harness"]
}